NODE_ENV=development
PORT=3000
# Origin of the client allowed by CORS
CLIENT_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=5433
DB_USER=film
DB_PASSWORD=film
DB_NAME=film
# Auto-sync schema with entities. Only for local development, never in production.
DB_SYNCHRONIZE=true

# Firebase service account (Project settings → Service accounts → Generate new private key).
# Leave empty to run without file storage.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# One line, keep the quotes and the literal \n sequences
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
